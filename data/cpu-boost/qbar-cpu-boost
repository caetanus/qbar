#!/bin/sh
# Privileged helper behind qbar's CPU boost toggle, run as root through pkexec
# (polkit action org.qbar.cpu-boost). Accepts exactly "0" or "1" and writes
# nothing but the kernel's boost control.
set -eu

case "${1:-}" in
    0|1) ;;
    *) echo "usage: qbar-cpu-boost 0|1" >&2; exit 2 ;;
esac

cpufreq=/sys/devices/system/cpu/cpufreq

# intel_pstate exposes the inverse knob.
if [ -w /sys/devices/system/cpu/intel_pstate/no_turbo ]; then
    printf '%s' "$((1 - $1))" > /sys/devices/system/cpu/intel_pstate/no_turbo
    exit 0
fi

if [ -w "$cpufreq/boost" ]; then
    printf '%s' "$1" > "$cpufreq/boost"
    exit 0
fi

found=0
for f in "$cpufreq"/policy*/boost; do
    [ -w "$f" ] || continue
    printf '%s' "$1" > "$f"
    found=1
done
[ "$found" -eq 1 ] || { echo "no writable cpufreq boost control" >&2; exit 1; }
